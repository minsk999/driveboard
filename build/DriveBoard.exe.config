<?xml version="1.0" encoding="utf-8"?>
<!-- 압축을 그냥 풀어 DLL 에 「인터넷에서 받음」 표식이 남아도 .NET(pythonnet·WebView2)이 로드하게 한다.
     앱이 시작할 때 표식을 지우기도 하지만(core/paths.unblock_bundle), 지우지 못한 경우의 이중 안전. -->
<configuration>
  <runtime>
    <loadFromRemoteSources enabled="true"/>
  </runtime>
</configuration>
